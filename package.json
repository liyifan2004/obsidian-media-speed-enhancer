{
  "name": "media-speed-enhancer",
  "version": "1.0.44",
  "description": "Obsidian 插件：在原生 HTML5 播放器上叠加 10s 跳转、按住倍速、自定义倍速切换按钮",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:styles": "stylelint styles.css",
    "verify": "npm run typecheck && npm run lint && npm run lint:styles && npm run test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json package.json",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "plugin",
    "media",
    "audio",
    "video",
    "speed"
  ],
  "author": "李轶凡",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.5.7",
    "stylelint": "^17.16.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.0",
    "vitest": "^5.1.0"
  }
}
